#!/usr/bin/env php
<?php

declare(strict_types=1);

use Platform\Kernel\Platform;

$autoload = dirname(__DIR__, 3) . '/vendor/autoload.php';

if (!is_file($autoload)) {
    fwrite(STDERR, "Autoloader not found. Run composer install from the project root.\n");
    exit(1);
}

require $autoload;

$identity = Platform::identity();

fwrite(STDOUT, sprintf(
    "%s %s (PHP %s)\n",
    $identity['name'],
    $identity['version'],
    $identity['php'],
));

exit(0);
