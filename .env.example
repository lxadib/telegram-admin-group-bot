# Application
APP_ENV=local
APP_DEBUG=true
APP_TIMEZONE=UTC

# Database (PostgreSQL) — used from Phase 4
DATABASE_URL=pgsql://platform:platform@127.0.0.1:5432/platform

# Redis — cache + queue from Phase 4
REDIS_URL=redis://127.0.0.1:6379/0

# Security
APP_KEY=
# Generate with: php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"

# Telegram (adapter only — Phase 6+)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Telegram user id that bypasses RBAC (platform operator) — Phase 7+
TELEGRAM_SUPER_OWNER_ID=

# Logging
LOG_LEVEL=debug
LOG_CHANNEL=stderr
